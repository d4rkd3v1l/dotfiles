#!/bin/bash

{{ if eq .chezmoi.os "darwin" -}}
# --- [ macOS ] ---------------------------------
echo "--- Running brew bundle ---"
brew bundle

echo "--- Configuring Finder & Dock ---"
if [[ $(defaults read com.apple.Finder AppleShowAllFiles) == "YES" ]]; then
  echo "Finder AppleShowAllFiles already set."
else
  echo "Setting Finder AppleShowAllFiles..."
  defaults write com.apple.Finder AppleShowAllFiles YES && killall Finder
fi
if [ $(defaults read com.apple.dock tilesize) -eq 48 ]; then
  echo "Dock tilesize already set to 48."
else
  echo "Setting Dock tilesize to 48..."
  defaults write com.apple.dock tilesize -int 48 && killall Dock
fi
if [[ $(defaults read-type com.apple.dock size-immutable) == "Type is boolean" ]] && [ $(defaults read com.apple.dock size-immutable) -eq 1 ]; then
  echo "Dock size already immutable."
else
  echp "Setting Dock size immutable..."
  defaults write com.apple.dock size-immutable -bool yes && killall Dock
fi

{{- else if eq .chezmoi.os "linux" -}}
# --- [ Linux ] ---------------------------------
# Change shell to zsh
if [[ $(getent passwd $LOGNAME | cut -d: -f7) != "/bin/zsh" ]]; then
  echo "Changing login shell to zsh..."
  sudo chsh -s /bin/zsh $LOGNAME
else
  echo "Login shell is already zsh."
fi

# Apt (TBD if this should be here or using nix?)
sudo apt install -y \
  git \
  tmux \
  xclip \
  command-not-found

# Nix package manager (for bleeding edge stuff like neovim)
echo "--- Installing Nix packages ---"
if command -v nix &> /dev/null; then
  echo "Nix already installed."
else
  echo "Installing Nix..."
  curl -L https://nixos.org/nix/install | sh -s -- --yes --no-modify-profile
  . $HOME/.nix-profile/etc/profile.d/nix.sh
fi
echo "Installing Nix packages..."
nix-env -iA \
  nixpkgs.neovim \
  nixpkgs.fzf \
  nixpkgs.ripgrep \
  nixpkgs.fd \
  nixpkgs.lazygit \
  nixpkgs.bat \
  nixpkgs.delta \
  nixpkgs.eza

# Ghostty
echo "--- Intalling ghostty ---"
GHOSTTY_URL=$(curl -s https://api.github.com/repos/mkasberg/ghostty-ubuntu/releases/latest | grep -oP "https://github.com/mkasberg/ghostty-ubuntu/releases/download/[^\s/]+/ghostty_[^\s/_]+_{{ .chezmoi.arch }}_bookworm.deb")
curl -Lo ghostty.deb "$GHOSTTY_URL"
sudo apt install -y -f ./ghostty.deb
rm ghostty.deb

{{- end }}

# --- [ General ] ---------------------------------
echo "--- Installing nerd-fonts ---"

{{ if eq .chezmoi.os "darwin" -}}
pushd "$HOME/Library/Fonts" > /dev/null
{{ else if eq .chezmoi.os "linux" -}}
mkdir "$HOME/.fonts"
pushd "$HOME/.fonts" > /dev/null
{{ end -}}

FONTS=("MesloLGSNerdFont-Regular.ttf" "MesloLGSNerdFont-Bold.ttf" "MesloLGSNerdFont-Italic.ttf" "MesloLGSNerdFont-BoldItalic.ttf")

for FONT in "${FONTS[@]}"; do
  if [ -f "$FONT" ]; then
    echo "$FONT already installed."
  else
    echo "Installing $FONT..."
    curl -L -O "https://github.com/ryanoasis/nerd-fonts/raw/refs/heads/master/patched-fonts/Meslo/S/Regular/$FONT"
  fi
done

popd > /dev/null

echo "--- Installing tmux plugin manager and plugins ---"
TPM_DIR="$HOME/.tmux/plugins/tpm"
if [ -d "$TPM_DIR" ]; then
  echo "Tmux plugin manager already installed."
else
  echo "Installing tmux plugin manager..."
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$TPM_DIR"
  echo "Installing plugins..."
  ~/.tmux/plugins/tpm/bin/install_plugins
fi

