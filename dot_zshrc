export EDITOR="nvim"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"

# VI mode
bindkey -v
export KEYTIMEOUT=25

# History
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Zinit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

# Plugins
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions

# zsh-syntax-highlighting overrides -> basically remove underlines
export ZSH_HIGHLIGHT_STYLES[path]=none
export ZSH_HIGHLIGHT_STYLES[path_pathseparator]=none
export ZSH_HIGHLIGHT_STYLES[path_prefix]=none
export ZSH_HIGHLIGHT_STYLES[path_prefix_pathseparator]=none
export ZSH_HIGHLIGHT_STYLES[precommand]="fg=green"

# Snippets
zinit snippet OMZL::directories.zsh
zinit snippet OMZP::command-not-found
zinit snippet OMZP::sudo

# Keybindings
bindkey '^r' history-incremental-search-backward
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward

# Aliases
if command -v gls &>/dev/null; then
  alias ls="gls --color=auto"
else
  alias ls="ls --color=auto"
fi
alias l='ls -lha'

# Load completions
autoload -Uz compinit && compinit
zinit cdreplay -q

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' menu select

# Powerlevel10k
zinit ice depth"1" # git clone depth
zinit light romkatv/powerlevel10k

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
